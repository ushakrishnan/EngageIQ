### frontend/.env.example
# Copy this file to `frontend/.env` (or set env vars in your environment)
# and edit values as needed for local development.
# IMPORTANT: This example contains only safe, non-secret values. Do NOT
# add production secrets (Cosmos keys, OpenAI keys, etc.) here — keep those
# in `backend/.env` or a secrets manager and let the backend handle them.

# Application
VITE_APP_NAME=EngageIQ
VITE_ENVIRONMENT=development
VITE_ENABLE_ANALYTICS=false
VITE_APP_VERSION=dev

# API / Admin server (backend endpoints)
VITE_API_BASE_URL=http://localhost:4000
VITE_ADMIN_SERVER_URL=http://localhost:4000

# Local dev helpers
DEBUG=false
