# EngageIQ Environment Configuration
# 
# Copy this file to .env and update with your actual values
# 
# 🚀 Quick Setup: Run `npm run cosmos:quick-setup` for interactive configuration

# Application Settings
VITE_APP_NAME=EngageIQ
VITE_ENVIRONMENT=development
VITE_ENABLE_ANALYTICS=false

# Database Configuration
# Options: "cosmos"
VITE_DATABASE_PROVIDER=cosmos

# Azure Cosmos DB Configuration
# 🔑 Required: Get these from Azure Portal → Your Cosmos DB Account → Settings → Keys
VITE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
VITE_COSMOS_KEY=your_cosmos_primary_key_here
# Optional: Database and container names (defaults shown)
VITE_COSMOS_DATABASE_NAME=EngageIQ
VITE_COSMOS_CONTAINER_NAME=data

# Optional: allow self-signed TLS certs for local Cosmos emulator (set to 1 for local dev only)
# ALLOW_SELF_SIGNED_TLS=1

# SECURITY NOTE: Store production secrets (Cosmos primary keys, AOAI keys, etc.)
# in this backend `.env` or a secure secrets store. Do NOT place production
# secrets in frontend `VITE_` env files — those are bundled into the client and
# can be exposed.

# Admin server / autotag service (the local dev admin server runs on port 4000 by default)
# This is the URL the client will use to call the autotag endpoint. Change if your admin server runs elsewhere.
VITE_ADMIN_SERVER_URL=http://localhost:4000
# Optional override for the admin server port (admin server reads process.env.PORT)
ADMIN_SERVER_PORT=4000

# Autotag provider configuration
# AUTOTAG_PROVIDER: set to AOAI to use Azure OpenAI, or FOUNDRY to use Foundry-Local (OpenAI-compatible endpoint)
AUTOTAG_PROVIDER=AOAI # or FOUNDRY

# Azure OpenAI (AOAI) settings — only required if AUTOTAG_PROVIDER=AOAI
# Example AOAI_ENDPOINT: https://<your-resource-name>.openai.azure.com
AOAI_ENDPOINT=https://your-aoai-endpoint.openai.azure.com
AOAI_KEY=your_azure_openai_key
AOAI_DEPLOYMENT=your_deployment_or_model_alias
AOAI_API_VERSION=2023-05-15

# Foundry Local settings — only required if AUTOTAG_PROVIDER=FOUNDRY
# Example FOUNDRY_ENDPOINT: http://localhost:8000 (Foundry Local exposes an OpenAI-compatible API)
FOUNDRY_ENDPOINT=http://localhost:8000
FOUNDRY_MODEL=phi-3.5-mini
# If your Foundry instance requires an API key, set it here; otherwise leave blank
FOUNDRY_KEY=

# Setup Configuration
SETUP_SEED_DATA=full
SETUP_COMPLETED=true

# Development Configuration
DEBUG=false

# Other optional runtime configuration
# e.g., feature toggles, local secrets, analytics, etc.
# VITE_SOME_FEATURE_FLAG=false


MESSAGE_SSE_SECRET=""